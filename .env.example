# Salin ke .env jika ingin dimodifikasi.
SENTIMENT_MODEL=w11wo/indonesian-roberta-base-sentiment-classifier
# Model commit yang di-pin membuat hasil dapat direproduksi pada instalasi berbeda.
SENTIMENT_MODEL_REVISION=ac452dcb0f4966130bba44f4ee0013bb5d52c282
MODEL_LOCAL_FILES_ONLY=false
# Default: .cache/models di dalam folder project.
# MODEL_CACHE_DIR=/absolute/path/to/model-cache
MAX_TEXT_CHARACTERS=30000
MAX_SEGMENTS=300
API_URL=http://127.0.0.1:8000
# direct: analisis dalam Streamlit; api: call FastAPI melalui API_URL.
ANALYSIS_MODE=direct
# Hanya diperlukan untuk mode YouTube Comments.
YOUTUBE_API_KEY=
